# API server. In `npm run dev` requests go through the Vite proxy (/api -> https://api.forky.ca).
# For production builds set the full host:
VITE_API_BASE_URL=https://api.forky.ca
# Mapbox PUBLIC token (pk.…) for street-address search (same one the Forky mobile app uses). Optional:
# without it the address search box is hidden and addresses are typed manually.
VITE_MAPBOX_TOKEN=
